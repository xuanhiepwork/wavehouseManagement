generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum BaseUnit {
  g
  ml
  piece
}

enum ProductSize {
  S
  M
  L
}

model Ingredient {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String             @unique @db.VarChar(64)
  name              String             @db.VarChar(200)
  category          String             @db.VarChar(100)
  unit              BaseUnit
  costPrice         Decimal            @map("cost_price") @db.Decimal(18, 4)
  minStock          Decimal            @default(0) @map("min_stock") @db.Decimal(18, 6)
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  recipeIngredients RecipeIngredient[]
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]
  goodsReceiptItems GoodsReceiptItem[]
  stockDocumentItems StockDocumentItem[]
  shiftStockCountItems ShiftStockCountItem[]
  transferReceiptItems TransferReceiptItem[]

  @@index([category, isActive])
  @@map("ingredients")
}

model Product {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique @db.VarChar(64)
  name        String           @db.VarChar(200)
  category    String           @db.VarChar(100)
  description String?
  imageUrl    String?          @map("image_url")
  isAvailable Boolean          @default(true) @map("is_available")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  variants    ProductVariant[]
  salesReportLines SalesReportLine[]

  @@index([category, isAvailable])
  @@map("products")
}

model ProductVariant {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String      @map("product_id") @db.Uuid
  size           ProductSize
  price          Decimal     @db.Decimal(18, 4)
  activeRecipeId String?     @map("active_recipe_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  product        Product     @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recipes        Recipe[]    @relation("VariantRecipes")
  activeRecipe   Recipe?     @relation("ActiveRecipe", fields: [activeRecipeId, id], references: [id, productVariantId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([productId, size])
  @@index([activeRecipeId, id])
  @@map("product_variants")
}

model Recipe {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productVariantId String             @map("product_variant_id") @db.Uuid
  version          Int                @default(1)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  productVariant   ProductVariant     @relation("VariantRecipes", fields: [productVariantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activeFor        ProductVariant[]   @relation("ActiveRecipe")
  ingredients      RecipeIngredient[]
  salesRecipeEvidence SalesRecipeEvidence[]

  @@unique([productVariantId, version])
  @@unique([id, productVariantId])
  @@map("recipes")
}

model RecipeIngredient {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipeId     String     @map("recipe_id") @db.Uuid
  ingredientId String     @map("ingredient_id") @db.Uuid
  quantity     Decimal    @db.Decimal(18, 6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([recipeId, ingredientId])
  @@index([ingredientId])
  @@map("recipe_ingredients")
}

enum UserRole {
  ADMIN
  BRANCH_MANAGER
  STAFF
}

model Branch {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(32)
  name      String   @db.VarChar(150)
  isActive  Boolean  @default(true) @map("is_active")
  receivingRevision Int @default(0) @map("receiving_revision")
  inventoryRevision Int @default(0) @map("inventory_revision")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  users User[]
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]
  goodsReceipts GoodsReceipt[]
  stockDocumentsSource      StockDocument[] @relation("StockDocumentSourceBranch")
  stockDocumentsDestination StockDocument[] @relation("StockDocumentDestinationBranch")
  shiftStockCounts ShiftStockCount[]
  salesReports SalesReport[]

  @@map("branches")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique @db.VarChar(254)
  displayName  String   @map("display_name") @db.VarChar(120)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole @default(STAFF)
  branchId     String?  @map("branch_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  inventoryMovements InventoryMovement[] @relation("InventoryMovementActor")
  receiptsCreated GoodsReceipt[] @relation("GoodsReceiptCreator")
  receiptsPosted  GoodsReceipt[] @relation("GoodsReceiptPoster")
  stockDocumentsCreated StockDocument[] @relation("StockDocumentCreator")
  stockDocumentsPosted  StockDocument[] @relation("StockDocumentPoster")
  shiftCountsCreated  ShiftStockCount[] @relation("ShiftCountCreator")
  shiftCountsApproved ShiftStockCount[] @relation("ShiftCountApprover")
  transferReceiptsCreated TransferReceipt[] @relation("TransferReceiptCreator")
  transferReceiptsReceived TransferReceipt[] @relation("TransferReceiptReceiver")
  salesReportsCreated SalesReport[] @relation("SalesReportCreator")
  salesReportsSubmitted SalesReport[] @relation("SalesReportSubmitter")
  salesReportsReviewed SalesReport[] @relation("SalesReportReviewer")
  salesRevisions SalesReportRevision[] @relation("SalesRevisionCreator")
  salesReportEvents SalesReportEvent[]
  salesRecipeEvidenceAttestations SalesRecipeEvidence[]

  @@index([branchId, isActive])
  @@map("users")
}

enum InventoryMovementKind {
  OPENING
  RECEIPT
  ISSUE
  TRANSFER_IN
  TRANSFER_OUT
  COUNT_ADJUSTMENT
  RECIPE_CONSUMPTION
}

model InventoryBalance {
  branchId     String   @map("branch_id") @db.Uuid
  ingredientId String   @map("ingredient_id") @db.Uuid
  quantity     Decimal  @default(0) @db.Decimal(18, 6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([branchId, ingredientId])
  @@index([ingredientId])
  @@map("inventory_balances")
}

model InventoryMovement {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId      String                @map("branch_id") @db.Uuid
  ingredientId  String                @map("ingredient_id") @db.Uuid
  actorId       String                @map("actor_id") @db.Uuid
  kind          InventoryMovementKind
  sourceId      String                @map("source_id") @db.Uuid
  delta         Decimal               @db.Decimal(18, 6)
  quantityAfter Decimal               @map("quantity_after") @db.Decimal(18, 6)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor      User       @relation("InventoryMovementActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([kind, sourceId, branchId, ingredientId])
  @@index([branchId, ingredientId, createdAt])
  @@index([actorId])
  @@map("inventory_movements")
}

enum GoodsReceiptStatus {
  DRAFT
  POSTED
  CANCELLED
}

model GoodsReceipt {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String             @unique @db.VarChar(40)
  branchId     String             @map("branch_id") @db.Uuid
  supplierName String?            @map("supplier_name") @db.VarChar(160)
  note         String?            @db.VarChar(500)
  status       GoodsReceiptStatus @default(DRAFT)
  createdById  String             @map("created_by_id") @db.Uuid
  postedById   String?            @map("posted_by_id") @db.Uuid
  postedAt     DateTime?          @map("posted_at") @db.Timestamptz(6)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch    Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy User               @relation("GoodsReceiptCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  postedBy  User?              @relation("GoodsReceiptPoster", fields: [postedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  items     GoodsReceiptItem[]

  @@index([branchId, status, createdAt])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptId    String   @map("receipt_id") @db.Uuid
  ingredientId String   @map("ingredient_id") @db.Uuid
  quantity     Decimal  @db.Decimal(18, 6)
  unitCost     Decimal  @map("unit_cost") @db.Decimal(18, 4)

  receipt    GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ingredient Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([receiptId, ingredientId])
  @@index([ingredientId])
  @@map("goods_receipt_items")
}

enum StockDocumentType {
  ISSUE
  TRANSFER
}

enum StockDocumentStatus {
  DRAFT
  POSTED
  CANCELLED
}

model StockDocument {
  legacyReceivingRequired Boolean @default(false) @map("legacy_receiving_required")
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                String              @unique @db.VarChar(40)
  type                StockDocumentType
  status              StockDocumentStatus @default(DRAFT)
  sourceBranchId      String              @map("source_branch_id") @db.Uuid
  destinationBranchId String?             @map("destination_branch_id") @db.Uuid
  note                String?             @db.VarChar(500)
  createdById         String              @map("created_by_id") @db.Uuid
  postedById          String?             @map("posted_by_id") @db.Uuid
  postedAt            DateTime?           @map("posted_at") @db.Timestamptz(6)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sourceBranch      Branch  @relation("StockDocumentSourceBranch", fields: [sourceBranchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  destinationBranch Branch? @relation("StockDocumentDestinationBranch", fields: [destinationBranchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy         User    @relation("StockDocumentCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  postedBy          User?   @relation("StockDocumentPoster", fields: [postedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  items             StockDocumentItem[]
  transferReceipt   TransferReceipt?

  @@index([type, sourceBranchId, status, createdAt])
  @@index([destinationBranchId, status, createdAt])
  @@map("stock_documents")
}

model StockDocumentItem {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId   String  @map("document_id") @db.Uuid
  ingredientId String  @map("ingredient_id") @db.Uuid
  quantity     Decimal @db.Decimal(18, 6)

  document   StockDocument @relation(fields: [documentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ingredient Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([documentId, ingredientId])
  @@index([ingredientId])
  @@map("stock_document_items")
}

enum WorkShift {
  MORNING
  AFTERNOON
  EVENING
}

enum ShiftStockCountStatus {
  DRAFT
  SUBMITTED
  RETURNED
  APPROVED
}

model ShiftStockCount {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId      String                @map("branch_id") @db.Uuid
  businessDate  DateTime              @map("business_date") @db.Date
  shift         WorkShift
  status        ShiftStockCountStatus @default(DRAFT)
  note          String?               @db.VarChar(500)
  returnReason  String?               @map("return_reason") @db.VarChar(500)
  createdById   String                @map("created_by_id") @db.Uuid
  approvedById  String?               @map("approved_by_id") @db.Uuid
  submittedAt   DateTime?             @map("submitted_at") @db.Timestamptz(6)
  submittedReceivingRevision Int?     @map("submitted_receiving_revision")
  submittedInventoryRevision Int?     @map("submitted_inventory_revision")
  approvedAt    DateTime?             @map("approved_at") @db.Timestamptz(6)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch     Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy  User                  @relation("ShiftCountCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvedBy User?                 @relation("ShiftCountApprover", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  items      ShiftStockCountItem[]

  @@unique([branchId, businessDate, shift])
  @@index([branchId, status, businessDate])
  @@map("shift_stock_counts")
}

model ShiftStockCountItem {
  countId          String   @map("count_id") @db.Uuid
  ingredientId     String   @map("ingredient_id") @db.Uuid
  countedQuantity  Decimal  @map("counted_quantity") @db.Decimal(18, 6)
  expectedQuantity Decimal? @map("expected_quantity") @db.Decimal(18, 6)
  variance         Decimal? @db.Decimal(18, 6)

  count      ShiftStockCount @relation(fields: [countId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ingredient Ingredient      @relation(fields: [ingredientId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([countId, ingredientId])
  @@index([ingredientId])
  @@map("shift_stock_count_items")
}

enum DemandDayType {
  WEEKDAY
  WEEKEND
  HOLIDAY
}

model DemandCalendarOverride {
  businessDate DateTime      @id @map("business_date") @db.Date
  dayType      DemandDayType @map("day_type")
  note         String?       @db.VarChar(200)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("demand_calendar_overrides")
}

enum TransferReceiptStatus {
  DRAFT
  CONFIRMED
}

model TransferReceipt {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stockDocumentId String                @unique @map("stock_document_id") @db.Uuid
  status          TransferReceiptStatus @default(DRAFT)
  version         Int                   @default(1)
  note            String?               @db.VarChar(500)
  createdById     String                @map("created_by_id") @db.Uuid
  receivedById    String?               @map("received_by_id") @db.Uuid
  confirmedAt     DateTime?             @map("confirmed_at") @db.Timestamptz(6)
  physicalReceivedAt DateTime?          @map("physical_received_at") @db.Timestamptz(6)
  legacyEvidence  String?               @map("legacy_evidence") @db.VarChar(1000)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  stockDocument StockDocument @relation(fields: [stockDocumentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy User @relation("TransferReceiptCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  receivedBy User? @relation("TransferReceiptReceiver", fields: [receivedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  items TransferReceiptItem[]

  @@index([status, updatedAt])
  @@index([createdById])
  @@index([receivedById])
  @@map("transfer_receipts")
}

model TransferReceiptItem {
  receiptId         String   @map("receipt_id") @db.Uuid
  ingredientId      String   @map("ingredient_id") @db.Uuid
  ingredientCode    String   @map("ingredient_code") @db.VarChar(64)
  ingredientName    String   @map("ingredient_name") @db.VarChar(200)
  unit              BaseUnit
  plannedQuantity   Decimal  @map("planned_quantity") @db.Decimal(18, 6)
  receivedQuantity  Decimal  @map("received_quantity") @db.Decimal(18, 6)
  damagedQuantity   Decimal  @map("damaged_quantity") @db.Decimal(18, 6)
  discrepancyReason String?  @map("discrepancy_reason") @db.VarChar(300)

  receipt TransferReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([receiptId, ingredientId])
  @@index([ingredientId])
  @@map("transfer_receipt_items")
}

enum SalesReportStatus {
  DRAFT
  SUBMITTED
  RETURNED
  APPROVED
}

enum SalesPaymentChannel {
  CASH
  BANK_TRANSFER
  MOMO
  GRAB
  OTHER
}

enum SalesReportEventType {
  CREATED
  UPDATED
  SUBMITTED
  RETURNED
  APPROVED
}

model SalesReport {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  businessDate DateTime @map("business_date") @db.Date
  shift WorkShift
  status SalesReportStatus @default(DRAFT)
  version Int @default(1)
  currentRevisionNumber Int @default(1) @map("current_revision_number")
  submittedRevisionNumber Int? @map("submitted_revision_number")
  approvedRevisionNumber Int? @map("approved_revision_number")
  createdById String @map("created_by_id") @db.Uuid
  submittedById String? @map("submitted_by_id") @db.Uuid
  reviewedById String? @map("reviewed_by_id") @db.Uuid
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(6)
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(6)
  approvedAt DateTime? @map("approved_at") @db.Timestamptz(6)
  returnReason String? @map("return_reason") @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy User @relation("SalesReportCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  submittedBy User? @relation("SalesReportSubmitter", fields: [submittedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewedBy User? @relation("SalesReportReviewer", fields: [reviewedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revisions SalesReportRevision[]
  events SalesReportEvent[]

  @@unique([branchId, businessDate, shift])
  @@index([branchId, status, businessDate])
  @@index([status, businessDate])
  @@index([createdById])
  @@index([submittedById])
  @@index([reviewedById])
  @@map("sales_reports")
}

// Every save appends a complete revision; submitted snapshots are never edited.
model SalesReportRevision {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId String @map("report_id") @db.Uuid
  number Int
  createdById String @map("created_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  note String? @db.VarChar(1500)
  discounts Decimal @db.Decimal(18, 0)
  recognizedRefunds Decimal @map("recognized_refunds") @db.Decimal(18, 0)
  grossSales Decimal @map("gross_sales") @db.Decimal(18, 0)
  netExpected Decimal @map("net_expected") @db.Decimal(18, 0)
  netRecorded Decimal @map("net_recorded") @db.Decimal(18, 0)
  salesDifference Decimal @map("sales_difference") @db.Decimal(18, 0)
  expectedCash Decimal @map("expected_cash") @db.Decimal(18, 0)
  cashDifference Decimal? @map("cash_difference") @db.Decimal(18, 0)

  report SalesReport @relation(fields: [reportId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy User @relation("SalesRevisionCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lines SalesReportLine[]
  payments SalesPayment[]
  expenses SalesExpense[]
  cash CashReconciliation?
  events SalesReportEvent[]

  @@unique([reportId, number])
  @@index([createdById])
  @@map("sales_report_revisions")
}

model SalesReportLine {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revisionId String @map("revision_id") @db.Uuid
  position Int
  productId String? @map("product_id") @db.Uuid
  productNameSnapshot String @map("product_name_snapshot") @db.VarChar(200)
  size String @db.VarChar(10)
  unitPriceSnapshot Decimal @map("unit_price_snapshot") @db.Decimal(18, 0)
  quantity Int
  note String? @db.VarChar(240)

  revision SalesReportRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recipeEvidence SalesRecipeEvidence?

  @@unique([revisionId, position])
  @@index([productId])
  @@map("sales_report_lines")
}

model SalesPayment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revisionId String @map("revision_id") @db.Uuid
  channel SalesPaymentChannel
  collectedAmount Decimal @map("collected_amount") @db.Decimal(18, 0)
  refundedAmount Decimal @map("refunded_amount") @db.Decimal(18, 0)
  platformFee Decimal @map("platform_fee") @db.Decimal(18, 0)
  settlementDifference Decimal @map("settlement_difference") @db.Decimal(18, 0)
  note String? @db.VarChar(300)
  revision SalesReportRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([revisionId, channel])
  @@map("sales_report_payments")
}

model SalesExpense {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revisionId String @map("revision_id") @db.Uuid
  position Int
  channel SalesPaymentChannel
  description String @db.VarChar(300)
  amount Decimal @db.Decimal(18, 0)
  revision SalesReportRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([revisionId, position])
  @@map("sales_report_expenses")
}

model CashReconciliation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revisionId String @unique @map("revision_id") @db.Uuid
  openingCash Decimal @map("opening_cash") @db.Decimal(18, 0)
  cashHandovers Decimal @map("cash_handovers") @db.Decimal(18, 0)
  closingCashActual Decimal? @map("closing_cash_actual") @db.Decimal(18, 0)
  revision SalesReportRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("sales_cash_reconciliations")
}

model SalesReportEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId String @map("report_id") @db.Uuid
  revisionNumber Int @map("revision_number")
  actorId String @map("actor_id") @db.Uuid
  type SalesReportEventType
  reason String? @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  report SalesReport @relation(fields: [reportId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revision SalesReportRevision @relation(fields: [reportId, revisionNumber], references: [reportId, number], onDelete: Restrict, onUpdate: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([reportId, createdAt])
  @@index([actorId])
  @@map("sales_report_events")
}

// AI5: A human-attested recipe snapshot for a single approved W7.3 line.
// Never created automatically from today's Catalog; append-only DB trigger.
model SalesRecipeEvidence {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salesLineId String @unique @map("sales_line_id") @db.Uuid
  recipeId String @map("recipe_id") @db.Uuid
  recipeVersion Int @map("recipe_version")
  productVariantId String @map("product_variant_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  size ProductSize
  ingredientSnapshot Json @map("ingredient_snapshot") @db.JsonB
  recipeCreatedAt DateTime @map("recipe_created_at") @db.Timestamptz(6)
  attestedById String @map("attested_by_id") @db.Uuid
  attestedAt DateTime @default(now()) @map("attested_at") @db.Timestamptz(6)
  attestationNote String @map("attestation_note") @db.VarChar(500)

  line SalesReportLine @relation(fields: [salesLineId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attestedBy User @relation(fields: [attestedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([attestedAt])
  @@index([recipeId])
  @@map("sales_recipe_evidence")
}
