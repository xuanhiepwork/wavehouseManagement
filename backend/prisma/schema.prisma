generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum BaseUnit {
  g
  ml
  piece
}

enum ProductSize {
  S
  M
  L
}

model Ingredient {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String             @unique @db.VarChar(64)
  name              String             @db.VarChar(200)
  category          String             @db.VarChar(100)
  unit              BaseUnit
  costPrice         Decimal            @map("cost_price") @db.Decimal(18, 4)
  minStock          Decimal            @default(0) @map("min_stock") @db.Decimal(18, 6)
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  recipeIngredients RecipeIngredient[]
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]
  goodsReceiptItems GoodsReceiptItem[]

  @@index([category, isActive])
  @@map("ingredients")
}

model Product {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique @db.VarChar(64)
  name        String           @db.VarChar(200)
  category    String           @db.VarChar(100)
  description String?
  imageUrl    String?          @map("image_url")
  isAvailable Boolean          @default(true) @map("is_available")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  variants    ProductVariant[]

  @@index([category, isAvailable])
  @@map("products")
}

model ProductVariant {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String      @map("product_id") @db.Uuid
  size           ProductSize
  price          Decimal     @db.Decimal(18, 4)
  activeRecipeId String?     @map("active_recipe_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  product        Product     @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recipes        Recipe[]    @relation("VariantRecipes")
  activeRecipe   Recipe?     @relation("ActiveRecipe", fields: [activeRecipeId, id], references: [id, productVariantId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([productId, size])
  @@index([activeRecipeId, id])
  @@map("product_variants")
}

model Recipe {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productVariantId String             @map("product_variant_id") @db.Uuid
  version          Int                @default(1)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  productVariant   ProductVariant     @relation("VariantRecipes", fields: [productVariantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activeFor        ProductVariant[]   @relation("ActiveRecipe")
  ingredients      RecipeIngredient[]

  @@unique([productVariantId, version])
  @@unique([id, productVariantId])
  @@map("recipes")
}

model RecipeIngredient {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipeId     String     @map("recipe_id") @db.Uuid
  ingredientId String     @map("ingredient_id") @db.Uuid
  quantity     Decimal    @db.Decimal(18, 6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([recipeId, ingredientId])
  @@index([ingredientId])
  @@map("recipe_ingredients")
}

enum UserRole {
  ADMIN
  BRANCH_MANAGER
  STAFF
}

model Branch {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(32)
  name      String   @db.VarChar(150)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  users User[]
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]
  goodsReceipts GoodsReceipt[]

  @@map("branches")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique @db.VarChar(254)
  displayName  String   @map("display_name") @db.VarChar(120)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole @default(STAFF)
  branchId     String?  @map("branch_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  inventoryMovements InventoryMovement[] @relation("InventoryMovementActor")
  receiptsCreated GoodsReceipt[] @relation("GoodsReceiptCreator")
  receiptsPosted  GoodsReceipt[] @relation("GoodsReceiptPoster")

  @@index([branchId, isActive])
  @@map("users")
}

enum InventoryMovementKind {
  OPENING
  RECEIPT
  ISSUE
  TRANSFER_IN
  TRANSFER_OUT
  COUNT_ADJUSTMENT
  RECIPE_CONSUMPTION
}

model InventoryBalance {
  branchId     String   @map("branch_id") @db.Uuid
  ingredientId String   @map("ingredient_id") @db.Uuid
  quantity     Decimal  @default(0) @db.Decimal(18, 6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([branchId, ingredientId])
  @@index([ingredientId])
  @@map("inventory_balances")
}

model InventoryMovement {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId      String                @map("branch_id") @db.Uuid
  ingredientId  String                @map("ingredient_id") @db.Uuid
  actorId       String                @map("actor_id") @db.Uuid
  kind          InventoryMovementKind
  sourceId      String                @map("source_id") @db.Uuid
  delta         Decimal               @db.Decimal(18, 6)
  quantityAfter Decimal               @map("quantity_after") @db.Decimal(18, 6)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor      User       @relation("InventoryMovementActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([kind, sourceId, branchId, ingredientId])
  @@index([branchId, ingredientId, createdAt])
  @@index([actorId])
  @@map("inventory_movements")
}

enum GoodsReceiptStatus {
  DRAFT
  POSTED
  CANCELLED
}

model GoodsReceipt {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String             @unique @db.VarChar(40)
  branchId     String             @map("branch_id") @db.Uuid
  supplierName String?            @map("supplier_name") @db.VarChar(160)
  note         String?            @db.VarChar(500)
  status       GoodsReceiptStatus @default(DRAFT)
  createdById  String             @map("created_by_id") @db.Uuid
  postedById   String?            @map("posted_by_id") @db.Uuid
  postedAt     DateTime?          @map("posted_at") @db.Timestamptz(6)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch    Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy User               @relation("GoodsReceiptCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  postedBy  User?              @relation("GoodsReceiptPoster", fields: [postedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  items     GoodsReceiptItem[]

  @@index([branchId, status, createdAt])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptId    String   @map("receipt_id") @db.Uuid
  ingredientId String   @map("ingredient_id") @db.Uuid
  quantity     Decimal  @db.Decimal(18, 6)
  unitCost     Decimal  @map("unit_cost") @db.Decimal(18, 4)

  receipt    GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ingredient Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([receiptId, ingredientId])
  @@index([ingredientId])
  @@map("goods_receipt_items")
}