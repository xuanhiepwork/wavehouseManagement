PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/wavehouse_db
CORS_ORIGIN=http://localhost:3000

# Phase 1 tooling only: copy these PostgreSQL entries into backend/.env.postgres.
# Replace passwords and URL-encode special characters. Never use the admin role.
DATABASE_URL=postgresql://wavehouse_dev:REPLACE_ME@127.0.0.1:5433/wavehouse_dev?schema=public
SHADOW_DATABASE_URL=postgresql://wavehouse_dev:REPLACE_ME@127.0.0.1:5433/wavehouse_shadow?schema=public
TEST_DATABASE_URL=postgresql://wavehouse_test:REPLACE_ME@127.0.0.1:5433/wavehouse_test
