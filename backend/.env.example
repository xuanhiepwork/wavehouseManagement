# Copy to .env.local; never commit the file containing the actual password.
NODE_ENV=development
PORT=5001
CORS_ORIGIN=http://localhost:3000
CATALOG_POSTGRES_TARGET=aiven
AIVEN_DB_PASSWORD=REPLACE_WITH_WAVEHOUSE_APP_PASSWORD
# Relative paths resolve from backend/, regardless of the working directory.
AIVEN_CA_PATH=../ca.pem
# Keep enabled for approved read-only checks on Aiven wavehouse_dev.
POSTGRES_READ_ONLY=true

# No CATALOG_*_STORE flags are needed; all catalog modules use PostgreSQL.
# Optional isolated local development target: CATALOG_POSTGRES_TARGET=local
# DATABASE_URL=postgresql://wavehouse_dev:REPLACE_ME@127.0.0.1:5433/wavehouse_dev?schema=public
# TEST_DATABASE_URL=postgresql://wavehouse_test:REPLACE_ME@127.0.0.1:5433/wavehouse_test
